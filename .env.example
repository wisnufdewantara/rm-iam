# Salin ke .env.local dan isi sendiri. .env.local TIDAK ikut ke git.
#
# Project ini memakai SKEMA API KEY BARU Supabase (sb_publishable_ / sb_secret_),
# bukan anon/service_role JWT lama. Lihat PRD §7.1.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key: aman di browser SELAMA RLS aktif. Menghormati RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Secret key SENGAJA TIDAK DIPAKAI (PRD §7.1).
# Semua akses istimewa lewat fungsi Postgres `security definer`, supaya
# kebocoran env var tidak berarti kebocoran seluruh database.
# Kalau suatu saat terpaksa: server-only, dan JANGAN diberi awalan NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
